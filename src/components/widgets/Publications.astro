---
interface Props {
	items?: string[];
}

const { items = [] } = Astro.props;
---

<div class="pubs">
	{items.map((item) => <span>{item}</span>)}
</div>

<style>
	.pubs {
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		color: #8f8070;
	}
</style>

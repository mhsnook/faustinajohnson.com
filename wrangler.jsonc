{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "faustinajohnson-com",
	// This token can see more than one account; name the one that owns the
	// worker, the domain, and the bindings below.
	"account_id": "c9d80e4dec35727da326297ef5b88f04",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	// Canonical origin for outbound links. EmDash resolves these as
	// EMDASH_SITE_URL -> stored `emdash:site_url` -> request URL, and the stored
	// value is written once at setup: running setup on the workers.dev URL is
	// what made magic links point there. Pinning it here outranks the store.
	"vars": {
		"EMDASH_SITE_URL": "https://faustinajohnson.com",
	},
	// Cloudflare Email Sending, for magic-link login and recovery mail. The
	// sender subdomain mail.faustinajohnson.com is onboarded with SPF, DKIM and
	// DMARC; the apex is deliberately left free for other mail providers.
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	// Cloudflare Images powers astro:assets transforms. The adapter's default
	// imageService is "cloudflare-binding", which looks for this binding.
	// Account-level service -- nothing to create, just declare it.
	"images": {
		"binding": "IMAGES",
	},
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance. Media usage tracking has no trigger: since emdash
	// 0.36.0 it advances only while Settings -> Media usage tracking is open.
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
# Cloudflare Access, the admin login. Neither value is a secret -- the AUD tag
# is a public identifier and the JWT's signature is what actually proves
# anything -- but they differ per account, so they live here rather than in
# astro.config.mjs. Both are read at build time.

# Zero Trust -> Settings -> Custom Pages, or the team name in the dashboard URL.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Zero Trust -> Access -> Applications -> (the app) -> Overview -> Application Audience (AUD) Tag.
CF_ACCESS_AUD=

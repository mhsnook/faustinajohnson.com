# Cloudflare Access -- the admin login. Neither value is a secret, and both are
# read at build time. Full setup: docs/auth.md

# Zero Trust -> Settings -> Custom Pages, or the team name in the dashboard URL.
CF_ACCESS_TEAM_DOMAIN=

# Zero Trust -> Access -> Applications -> (the app) -> Overview -> Application Audience (AUD) Tag.
CF_ACCESS_AUD=

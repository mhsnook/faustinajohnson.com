---
import Base from "../layouts/Base.astro";
---

<Base title="Not Found" heroTitle="404" heroKicker="the room is empty">
	<section class="panel panel--hearth">
		<div class="glow glow--hearth" aria-hidden="true"></div>
		<div class="hearth__inner">
			<h1 class="hearth__title">Nothing at this address</h1>
			<p class="hearth__body">
				The page moved, or it was never here. The work is all still on the shelf.
			</p>
			<div class="hearth__actions">
				<a class="btn btn--ember" href="/">back to the front</a>
				<a class="btn" href="/posts">the work</a>
			</div>
		</div>
	</section>
</Base>

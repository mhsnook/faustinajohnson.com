---
import { getEmDashCollection } from "emdash";
import NoteList from "../../components/NoteList.astro";
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";
import { getSnippets } from "../../utils/snippets";

const { entries: notes, cacheHint } = await getEmDashCollection("notes", {
	status: "published",
	orderBy: { note_date: "desc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { snippet } = await getSnippets();
---

<Base
	title={snippet("notes-page-title")}
	heroTitle={snippet("notes-page-title")}
	heroKicker={snippet("notes-page-kicker")}
>
	<section class="panel">
		<SectionHead
			title={snippet("notes-section-heading")}
			meta={`${notes.length} in total`}
			rule="dim"
		/>
		{notes.length === 0 ? <p class="empty">No notes yet.</p> : <NoteList notes={notes} />}
	</section>
</Base>

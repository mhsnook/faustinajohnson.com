---
interface Props {
	track?: string;
	meta?: string;
	/** Play position as a percentage, 0–100. */
	progress?: number;
}

const { track = "", meta = "", progress = 0 } = Astro.props;
const clamped = Math.min(100, Math.max(0, progress));
const bars = [
	{ w: "1.1s", d: "0s", c: "var(--ember-bright)" },
	{ w: "0.8s", d: "0.1s", c: "var(--ember-bright)" },
	{ w: "1.4s", d: "0.2s", c: "var(--gold)" },
	{ w: "0.95s", d: "0.05s", c: "var(--ember-bright)" },
	{ w: "1.25s", d: "0.3s", c: "var(--gold)" },
	{ w: "0.7s", d: "0.15s", c: "var(--ember-bright)" },
	{ w: "1.5s", d: "0.25s", c: "var(--flame)" },
];
---

<div class="eq" aria-hidden="true">
	{
		bars.map((bar) => (
			<span style={`animation-duration:${bar.w};animation-delay:${bar.d};background:${bar.c}`} />
		))
	}
</div>
{track && <div class="np__track">{track}</div>}
{meta && <div class="np__meta">{meta}</div>}
<div class="np__bar">
	<div class="np__fill" style={`width:${clamped}%`}></div>
</div>

<style>
	.eq {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 18px;
		margin-bottom: 9px;
	}

	.eq span {
		width: 4px;
		height: 3px;
		animation-name: eq;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}

	.np__track {
		font-size: 16px;
		line-height: 1.35;
		color: var(--linen);
	}

	.np__meta {
		font-family: var(--font-mono);
		font-size: 10.5px;
		color: var(--muted);
		margin-top: 3px;
	}

	.np__bar {
		margin-top: 9px;
		height: 6px;
		background: var(--ink-2);
		border: 1px solid #2a221c;
		box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.9);
	}

	.np__fill {
		height: 100%;
		background: linear-gradient(90deg, var(--crimson-top), var(--gold));
	}
</style>

# Both values are literals in astro.config.mjs, so a build needs neither. Set
# them here only to point a build at a different Access application.

# Zero Trust -> Settings -> Custom Pages, or the team name in the dashboard URL.
CF_ACCESS_TEAM_DOMAIN=

# Zero Trust -> Access -> Applications -> (the app) -> Overview -> Application Audience (AUD) Tag.
CF_ACCESS_AUD=

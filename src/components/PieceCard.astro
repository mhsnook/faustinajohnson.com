---
import type { MediaValue } from "emdash";
import Frame from "./Frame.astro";

interface Props {
	href: string;
	title: string;
	kicker?: string | null;
	excerpt?: string | null;
	image?: MediaValue | null;
	/** Puts the image on the right. The Work alternates it down the column. */
	flip?: boolean;
}

const { href, title, kicker, excerpt, image, flip = false } = Astro.props;
---

<a class:list={["piece", flip && "piece--flip"]} href={href}>
	<div class="piece__figure">
		<Frame image={image} label={"lead image\nno image yet"} />
	</div>
	<div class="piece__body">
		{kicker && <div class="kicker piece__kicker">{kicker}</div>}
		<h3 class="piece__title">{title}</h3>
		{excerpt && <p class="piece__excerpt">{excerpt}</p>}
		<span class="piece__cta">read the piece →</span>
	</div>
</a>

<style>
	.piece {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: 22px;
		padding: 18px;
		background: linear-gradient(var(--panel-alt-top), var(--panel-bottom));
		border: 2px solid;
		border-color: var(--bevel-light) var(--bevel-dark) var(--bevel-darker) var(--bevel-mid);
		box-shadow: inset 0 1px 0 rgba(255, 214, 160, 0.12), 0 3px 0 #000;
	}

	.piece:hover {
		border-color: var(--bevel-hot) var(--bevel-dark) var(--bevel-darker) var(--bevel-hot-2);
		box-shadow:
			inset 0 0 46px rgba(255, 140, 50, 0.14),
			0 3px 0 #000,
			0 0 34px rgba(255, 130, 40, 0.12);
	}

	.piece--flip {
		grid-template-columns: minmax(0, 1fr) 200px;
	}

	.piece--flip .piece__figure {
		order: 2;
	}

	.piece__figure {
		min-width: 0;
	}

	.piece__body {
		min-width: 0;
	}

	.piece__kicker {
		margin-bottom: 7px;
	}

	.piece__title {
		margin: 0 0 8px;
		font-family: var(--font-display);
		font-size: 29px;
		line-height: 1.1;
		font-weight: 400;
		color: var(--parchment);
	}

	.piece__excerpt {
		margin: 0 0 12px;
		font-size: 17px;
		line-height: 1.6;
		color: var(--body-2);
		text-wrap: pretty;
	}

	.piece__cta {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #e0c79c;
	}

	@media (max-width: 620px) {
		.piece,
		.piece--flip {
			grid-template-columns: minmax(0, 1fr);
		}

		.piece--flip .piece__figure {
			order: 0;
		}
	}
</style>

---
import { decodeSlug, getEmDashCollection, getTerm } from "emdash";
import TermArchive from "../../components/TermArchive.astro";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	where: { tag: term.slug },
	orderBy: { published_on: "desc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<TermArchive term={term} posts={posts} kind="tag" rule="dim" />

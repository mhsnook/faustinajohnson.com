---
import { getEmDashCollection } from "emdash";
import LiveSearch from "emdash/ui/search";
import PieceCard from "../../components/PieceCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_on: "desc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="The Work" heroTitle="The Work" heroKicker="everything, in order">
	<section>
		<SectionHead title="All Pieces" meta={`${posts.length} in total`} />

		<div class="search">
			<LiveSearch
				placeholder="Search the archive…"
				collections={["posts", "notes", "pages", "images"]}
			/>
		</div>

		{
			posts.length === 0 ? (
				<p class="empty">Nothing published yet.</p>
			) : (
				<div class="list">
					{posts.map((post, index) => (
						<div>
							<PieceCard
								href={`/posts/${post.id}`}
								title={post.data.title}
								kicker={post.data.kicker}
								excerpt={post.data.excerpt}
								image={post.data.featured_image}
								flip={index % 2 === 1}
							/>
							{(post.data.terms?.tag ?? []).length > 0 && (
								<div class="tags list__tags">
									{(post.data.terms?.tag ?? []).map((tag) => (
										<a href={`/tag/${tag.slug}`}>{tag.label}</a>
									))}
								</div>
							)}
						</div>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.search {
		margin-bottom: 20px;
	}

	.list__tags {
		margin-top: 8px;
		padding-left: 2px;
	}
</style>
